# ==============================================================================
# EduNet Analyzer - Environment Configuration Template
# ==============================================================================

# Server configuration
PORT=8000
HOST=0.0.0.0

# CORS settings (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Database connection URL
# Default: Local SQLite database
DATABASE_URL=sqlite:///./edunet.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/edunet

# Directory paths
SIMULATION_DIR=./simulation
STATIC_DIR=./frontend/dist

# Frontend variables (for Vite build/runtime)
# Default is relative '/api'
VITE_API_BASE=/api
# Optional custom WebSocket endpoint:
# VITE_WS_URL=wss://your-domain.getvoroa.com/api/simulations
