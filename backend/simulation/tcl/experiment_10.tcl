# NS-2 Simulation Script Generated by EduNet Analyzer
# Experiment ID: 10 | Users: 25 | Protocol: TCP
set ns [new Simulator]

set tracefile [open "/mnt/f/EduNet Analyzer/backend/simulation/traces/experiment_10.tr" w]
$ns trace-all $tracefile

# Node Definitions
# Student nodes (0 to 24)
for {set i 0} {$i < 25} {incr i} {
    set n($i) [$ns node]
}
set r1 [$ns node]      ;# Access Router (ID: 25)
set r2 [$ns node]      ;# Core Router (ID: 26)
set server [$ns node]  ;# E-Learning Server (ID: 27)

# Link Topologies
# Student to Access Router Links (10Mb, 5ms delay)
for {set i 0} {$i < 25} {incr i} {
    $ns duplex-link $n($i) $r1 10Mb 5ms DropTail
}

# Campus Core Bottleneck Link (Bandwidth: 1Mb, 20ms delay)
$ns duplex-link $r1 $r2 1Mb 20ms DropTail
$ns queue-limit $r1 $r2 25

# Core Router to E-Learning Server Link (100Mb, 2ms delay)
$ns duplex-link $r2 $server 100Mb 2ms DropTail

# Traffic Agents Setup
for {set i 0} {$i < 25} {incr i} {
    set tcp($i) [new Agent/TCP/Newreno]
    $tcp($i) set window_ 32
    $tcp($i) set packetSize_ 1024
    $ns attach-agent $n($i) $tcp($i)
    set sink($i) [new Agent/TCPSink]
    $ns attach-agent $server $sink($i)
    $ns connect $tcp($i) $sink($i)
    set ftp($i) [new Application/FTP]
    $ftp($i) attach-agent $tcp($i)
    $ns at [expr 0.1 + ($i * 0.05)] "$ftp($i) start"
    $ns at 59.5 "$ftp($i) stop"
}

# Termination Handler
$ns at 60.0 "finish"
proc finish {} {
    global ns tracefile
    $ns flush-trace
    close $tracefile
    exit 0
}

$ns run